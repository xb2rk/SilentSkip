# --- Server ---
# Port for the Hono API server (default 3000)
PORT=3000
# Bind host; keep localhost only — this tool is local-first (default 127.0.0.1)
HOST=127.0.0.1
# pino log level: trace | debug | info | warn | error (default: debug in dev, info in production)
LOG_LEVEL=debug

# --- Storage ---
# SQLite database file (default: %LOCALAPPDATA%\SilentSkip\data.sqlite on Windows,
# ~/.silentskip/data.sqlite elsewhere)
# SQLITE_PATH=

# --- AI (Insea workflow) ---
# Workflow run endpoint (Insea project 25537).
# AI_WORKFLOW_URL=https://ai.insea.io/api/workflows/25537/run
# Bearer token for the endpoint — take it from the shared secret store.
# AI_WORKFLOW_API_KEY=
# Per-request timeout in ms (default 180000). Insea runs can be slow; the canary probe
# (`pnpm --filter @silentskip/ai canary`) measures real latency.
# AI_WORKFLOW_TIMEOUT_MS=180000
