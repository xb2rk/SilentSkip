# --- Server ---
# Port for the Hono API server (default 3000)
PORT=3000
# Bind host; keep localhost only — this tool is local-first (default 127.0.0.1)
HOST=127.0.0.1
# pino log level: trace | debug | info | warn | error (default: debug in dev, info in production)
LOG_LEVEL=debug

# --- Storage ---
# SQLite database file (default: %LOCALAPPDATA%\CraftlandQA\data.sqlite on Windows,
# ~/.craftland-qa/data.sqlite elsewhere)
# SQLITE_PATH=

# --- AI (Phase 1 / E4 — Insea workflow) ---
# Workflow run endpoint (Insea project 25537 — the same workflow the previous QA used).
# AI_WORKFLOW_URL=https://ai.insea.io/api/workflows/25537/run
# Bearer token for the endpoint — see the old QA / NhaiDay_2 .env files.
# AI_WORKFLOW_API_KEY=
# Per-request timeout in ms (default 180000). Insea runs can be slow; the canary probe
# (`pnpm --filter @craftland-qa/ai canary`) measures real latency.
# AI_WORKFLOW_TIMEOUT_MS=180000
