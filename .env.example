# --- Server ---
# Port for the Hono API server (default 3000)
PORT=3000
# Bind host; keep localhost only — this tool is local-first (default 127.0.0.1)
HOST=127.0.0.1
# pino log level: trace | debug | info | warn | error (default: debug in dev, info in production)
LOG_LEVEL=debug

# --- Storage ---
# SQLite database file (default: %LOCALAPPDATA%\SilentSkip\data.sqlite on Windows,
# ~/.silentskip/data.sqlite elsewhere)
# SQLITE_PATH=

# --- AI (Insea workflow) ---
# Workflow run endpoint (Insea project 25537).
# AI_WORKFLOW_URL=https://ai.insea.io/api/workflows/25537/run
# Bearer token for the endpoint — take it from the shared secret store.
# AI_WORKFLOW_API_KEY=
# Per-request timeout in ms (default 180000). Insea runs can be slow; the canary probe
# (`pnpm --filter @silentskip/ai canary`) measures real latency.
# AI_WORKFLOW_TIMEOUT_MS=180000
# Reuse workflow answers for byte-identical calls (default: on). Rerunning the same comparison
# then replays the passes it already paid for instead of calling again; set to off to force live
# calls (e.g. after the workflow behind the URL changed).
# AI_PASS_CACHE=on
# Max reading units read at once (default: 1, range 1-16). This endpoint queues overlapping calls
# instead of speeding them up (a real 72-file run was no faster at 3 than at 1), so leave it at 1
# unless you re-measure with real payloads: pnpm --filter @silentskip/ai canary -- --parallel 3
# AI_READ_CONCURRENCY=1
